@page "/"
@using Mixel.Core
@using Mixel.Web.Components
@using Mixel.Web.Interop
@using Mixel.Web.Services
@using Mixel.Web.Theming
@inject ThemeState Theme
@inject MixelJs Js
@implements IDisposable

<TopBar>
    <button class="btn primary" disabled="@(_selectedCount == 0)" @onclick="ExportAsync">
        @(_selectedCount > 1 ? $"Export {_selectedCount} (.zip)" : "Export")
    </button>
</TopBar>

<div class="workspace">
    <FilePanel Items="_files" Sheets="_sheets" SelectedPreview="_selected"
               OnUpload="HandleUpload" OnLoadSample="LoadSampleAsync"
               OnPreview="SelectAsync" OnToggle="ToggleAsync"
               OnSelectAll="SelectAll" OnDeselectAll="DeselectAll"
               OnUploadSheet="HandleSheetUpload" OnSliceSheet="OpenSlicer" />

    <section class="stage">
        @* Simple-mode image viewer — shows the selected sprite when pip is not fullscreen *@
        @if (!_settings.PerPixelMode && CurrentItem != null && !_previewExpanded)
        {
            <div class="stage-content stage-image-view">
                <img src="@GetImageDataUrl(CurrentItem)" class="stage-image" alt="@CurrentItem.Name" />
            </div>
        }

        @* Depth painter fills stage when in per-pixel mode and not expanded *@
        @if (_settings.PerPixelMode && CurrentItem != null && !_previewExpanded)
        {
            <div class="stage-content">
                <DepthPainter Item="CurrentItem" Settings="_settings" OnChanged="RegenAsync" />
            </div>
        }

        @if (_files.Count == 0) { <div class="hint">Add pixel art to begin</div> }
        @if (_notice is not null)
        {
            <div class="notice">@_notice<button @onclick="() => _notice = null" aria-label="Dismiss">✕</button></div>
        }

        @* Floating 3D preview pip — collapses to bottom-left, expands to full stage *@
        <div class="preview-pip @(_previewExpanded ? "pip-expanded" : "")">
            <ModelPreview @ref="_preview" />
            @if (!_previewExpanded)
            {
                <button class="pip-btn pip-btn-expand" @onclick="ExpandPreview" title="Expand 3D view">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <path d="M8 1h4v4M5 12H1V8M12 1 7.5 5.5M5.5 7.5 1 12"
                              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
            else
            {
                <button class="pip-btn pip-btn-collapse" @onclick="CollapsePreview" title="Minimize to corner">
                    <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
                        <path d="M5 12H1V8M8 1h4v4M1 12l4.5-4.5M7.5 5.5 12 1"
                              stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </button>
            }
        </div>

        <OptionsWidget Settings="_settings" OnChanged="OnSettingsChanged" />
    </section>
</div>

@if (_sheetBytes is not null)
{
    <SlicerDialog SheetBytes="_sheetBytes" SheetName="@_sheetName"
                  AllowNonStandardSize="_settings.AllowNonStandardSize"
                  OnExtract="OnSlicerExtract" OnClose="CloseSlicer" />
}

@code {
    private readonly ExtrudeSettings _settings = new();
    private List<FileItem> _files = new();
    private List<SpritesheetItem> _sheets = new();
    private int _selected = -1;
    private ModelPreview? _preview;
    private string? _notice;
    private bool _previewExpanded = false;
    private byte[]? _sheetBytes;
    private string _sheetName = "spritesheet.png";

    private int _selectedCount => _files.Count(f => f.Selected);
    private FileItem? CurrentItem => _selected >= 0 && _selected < _files.Count ? _files[_selected] : null;

    protected override async Task OnInitializedAsync()
    {
        Theme.Changed += OnThemeChanged;
        await Theme.InitAsync();
    }

    private async void OnThemeChanged()
    {
        try { await Js.SetThemeAttributeAsync(Theme.CurrentId); await InvokeAsync(StateHasChanged); }
        catch (Exception) { }
    }

    private async Task LoadSampleAsync()
    {
        var bytes = await Js.FetchBytesAsync("/samples/rainbow16.png");
        await HandleUpload(new[] { ("rainbow16.png", bytes) });
    }

    private async Task HandleUpload(IReadOnlyList<(string name, byte[] bytes)> files)
    {
        bool wasEmpty = _files.Count == 0;
        foreach (var (name, bytes) in files)
            _files.Add(new FileItem { Name = name, Bytes = bytes });
        if (wasEmpty && _files.Count > 0) _selected = 0;
        if (_settings.PerPixelMode)
            foreach (var f in _files) EnsureDepthLevels(f);
        await RegenAsync();
    }

    private void HandleSheetUpload((string name, byte[] bytes) sheet)
    {
        _sheets.Add(new SpritesheetItem { Name = sheet.name, Bytes = sheet.bytes });
        StateHasChanged();
    }

    private async Task SelectAsync(int idx)
    {
        _selected = idx;
        if (_settings.PerPixelMode) EnsureDepthLevels(CurrentItem);
        await RegenAsync();
    }

    private Task ToggleAsync(int idx)
    {
        _files[idx].Selected = !_files[idx].Selected;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SelectAll() { foreach (var f in _files) f.Selected = true; StateHasChanged(); }
    private void DeselectAll() { foreach (var f in _files) f.Selected = false; StateHasChanged(); }

    private async Task OnSettingsChanged()
    {
        if (_settings.PerPixelMode) EnsureDepthLevels(CurrentItem);
        await RegenAsync();
    }

    private void ExpandPreview() { _previewExpanded = true; StateHasChanged(); }
    private void CollapsePreview() { _previewExpanded = false; StateHasChanged(); }

    private void OpenSlicer(SpritesheetItem sheet)
    {
        _sheetName  = sheet.Name;
        _sheetBytes = sheet.Bytes;
        StateHasChanged();
    }

    private void CloseSlicer() { _sheetBytes = null; StateHasChanged(); }

    private async Task OnSlicerExtract(IReadOnlyList<(string name, byte[] bytes)> sprites)
    {
        _sheetBytes = null;
        await HandleUpload(sprites);
    }

    private static string GetImageDataUrl(FileItem item)
        => $"data:image/png;base64,{Convert.ToBase64String(item.Bytes)}";

    private static void EnsureDepthLevels(FileItem? item)
    {
        if (item == null || item.DepthLevels != null) return;
        RgbaImage img;
        try { img = PngLoader.Load(item.Bytes); }
        catch (InvalidPngException) { return; }
        int w = img.Width, h = img.Height;
        var levels = new byte[w * h];
        var solid  = new bool[w * h];
        var rgba   = new byte[img.Pixels.Length * 4];
        for (int i = 0; i < img.Pixels.Length; i++)
        {
            var p = img.Pixels[i];
            bool opaque = p.A > 0;
            solid[i]  = opaque;
            levels[i] = opaque ? (byte)1 : (byte)0;
            rgba[i * 4]     = p.R;
            rgba[i * 4 + 1] = p.G;
            rgba[i * 4 + 2] = p.B;
            rgba[i * 4 + 3] = p.A;
        }
        item.DepthLevels  = levels;
        item.SolidMask    = solid;
        item.RgbaBytes    = rgba;
        item.DepthWidth   = w;
        item.DepthHeight  = h;
    }

    private async Task RegenAsync()
    {
        if (_selected < 0 || _selected >= _files.Count || _preview is null) return;
        try
        {
            var item = CurrentItem;
            if (item is null) return;
            var glb = ExtrusionService.PreviewGlb(item.Bytes, _settings, item);
            await _preview.ShowAsync(glb);
            _notice = null;
        }
        catch (InvalidImageSizeException ex) { _notice = ex.Message; }
        catch { }
        StateHasChanged();
    }

    private async Task ExportAsync()
    {
        var selected = _files.Where(f => f.Selected).ToList();
        if (selected.Count == 0) return;
        if (selected.Count == 1)
        {
            var f = selected[0];
            var name = Path.GetFileNameWithoutExtension(f.Name);
            try
            {
                var outFiles = ExtrusionService.Single(f.Bytes, name, _settings, f);
                if (outFiles.Count == 1)
                    await Js.DownloadFileAsync(outFiles[0].Name, outFiles[0].Bytes);
                else
                {
                    var zip = ExtrusionService.Zip(outFiles);
                    await Js.DownloadFileAsync(name + ".zip", zip);
                }
                _notice = null;
            }
            catch (InvalidImageSizeException ex) { _notice = ex.Message; }
        }
        else
        {
            var zip = ExtrusionService.BatchZip(
                selected.Select(f => (f.Name, f.Bytes, (FileItem?)f)).ToList(), _settings, out var outcomes);
            await Js.DownloadFileAsync("mixel-export.zip", zip);
            var failed = outcomes.Count(o => !o.Success);
            _notice = failed > 0 ? $"{failed} of {outcomes.Count} skipped (invalid size or image)." : null;
        }
    }

    public void Dispose() => Theme.Changed -= OnThemeChanged;
}
