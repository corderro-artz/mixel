@using Mixel.Core
@using Mixel.Web.Services

<div class="options">
    <div class="field">
        <label>Depth <span class="val">@Settings.Depth vox</span></label>
        <input type="range" min="1" max="32" step="1" data-test="depth"
               value="@Settings.Depth"
               @onchange="@(e => Set(() => Settings.Depth = Math.Max(1, ToInt(e.Value, 1))))" />
    </div>
    <div class="field">
        <label>Voxel size <span class="val">@Settings.VoxelSize</span></label>
        <input type="number" min="0.01" step="0.1" data-test="voxel"
               value="@Settings.VoxelSize"
               @onchange="@(e => Set(() => Settings.VoxelSize = Math.Max(0.01, ToDouble(e.Value, 1.0))))" />
    </div>
    <div class="field">
        <label>Format</label>
        <select data-test="format"
                @onchange="@(e => Set(() => Settings.Format = ParseFormat(e.Value?.ToString())))">
            <option value="Glb" selected="@(Settings.Format == GltfFormat.Glb)">glb</option>
            <option value="Gltf" selected="@(Settings.Format == GltfFormat.Gltf)">gltf</option>
            <option value="GltfEmbedded" selected="@(Settings.Format == GltfFormat.GltfEmbedded)">gltf-embedded</option>
        </select>
    </div>
    <div class="field">
        <label>Pivot</label>
        <select data-test="pivot"
                @onchange="@(e => Set(() => Settings.Pivot = ParsePivot(e.Value?.ToString())))">
            <option value="BottomCenter" selected="@(Settings.Pivot == Pivot.BottomCenter)">bottom-center</option>
            <option value="Center" selected="@(Settings.Pivot == Pivot.Center)">center</option>
            <option value="MinCorner" selected="@(Settings.Pivot == Pivot.MinCorner)">min-corner</option>
        </select>
    </div>
</div>

@code {
    [Parameter] public ExtrudeSettings Settings { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private async Task Set(Action mutate) { mutate(); await OnChanged.InvokeAsync(); }

    private static int ToInt(object? v, int dflt) => int.TryParse(v?.ToString(), out var r) ? r : dflt;
    private static double ToDouble(object? v, double dflt) => double.TryParse(v?.ToString(), out var r) ? r : dflt;

    public static GltfFormat ParseFormat(string? s) => s switch
    {
        "Gltf" => GltfFormat.Gltf,
        "GltfEmbedded" => GltfFormat.GltfEmbedded,
        _ => GltfFormat.Glb,
    };

    public static Pivot ParsePivot(string? s) => s switch
    {
        "Center" => Pivot.Center,
        "MinCorner" => Pivot.MinCorner,
        _ => Pivot.BottomCenter,
    };
}
