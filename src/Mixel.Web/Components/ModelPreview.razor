@using Mixel.Web.Interop
@inject MixelJs Js

<model-viewer @ref="_el" camera-controls touch-action="pan-y" exposure="1"
              shadow-intensity="0.6" class="preview"
              min-camera-orbit="auto auto 1%" max-camera-orbit="auto auto 4000%"
              min-field-of-view="2deg" max-field-of-view="120deg"></model-viewer>

@code {
    private ElementReference _el;
    public async Task ShowAsync(byte[] glb) => await Js.SetModelSrcAsync(_el, glb);
}
