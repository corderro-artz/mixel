@using Mixel.Web.Interop
@using Mixel.Web.Services
@using Microsoft.JSInterop
@inject MixelJs Js
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div class="depth-painter">
    <div class="painter-tools" data-test="painter-tools">
        <button class="tool-btn @Active(PainterTool.Paint)"   data-test="tool-paint"
                @onclick="@(()=>SetTool(PainterTool.Paint))">✏️</button>
        <button class="tool-btn @Active(PainterTool.Fill)"    data-test="tool-fill"
                @onclick="@(()=>SetTool(PainterTool.Fill))">🪣</button>
        <button class="tool-btn @Active(PainterTool.Eyedrop)" data-test="tool-eyedrop"
                @onclick="@(()=>SetTool(PainterTool.Eyedrop))">🔍</button>
        <button class="tool-btn @Active(PainterTool.Erase)"   data-test="tool-erase"
                @onclick="@(()=>SetTool(PainterTool.Erase))">✕</button>
        @if (Painter.Tool == PainterTool.Fill || Painter.Tool == PainterTool.Eyedrop)
        {
            <span class="level-badge" data-test="level-badge">Lv @Painter.ActiveLevel</span>
        }
    </div>

    @if (ShowSimpleModeHint)
    {
        <p class="depth-mode-hint">Painted depths ignored in Simple mode — switch to Per-pixel to use them.</p>
    }

    <div class="depth-canvas-wrap">
        <canvas id="depth-canvas" class="depth-canvas" data-test="depth-canvas"></canvas>
        <canvas id="depth-labels" class="depth-labels"></canvas>
    </div>
</div>

@code {
    [Parameter] public FileItem? Item { get; set; }
    [Parameter] public ExtrudeSettings Settings { get; set; } = new();
    [Parameter] public EventCallback OnChanged { get; set; }

    private readonly DepthPainterState Painter = new();
    private DotNetObjectReference<DepthPainter>? _self;
    private bool _canvasReady;
    private FileItem? _prevItem;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _self = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("mixel.listenCanvasInput",   "depth-canvas", _self);
            await JSRuntime.InvokeVoidAsync("mixel.listenContextMenu",   "depth-canvas", _self);
        }
        if (Item?.DepthLevels != null && Item.RgbaBytes != null && !_canvasReady)
        {
            _canvasReady = true;
            await Js.InitDepthCanvasAsync("depth-canvas", Item.RgbaBytes, Item.DepthWidth, Item.DepthHeight);
            await Js.RenderDepthOverlayAsync("depth-canvas", Item.DepthLevels,
                Item.DepthWidth, Item.DepthHeight, Settings.MaxDepthLevels);
            await Js.RenderDepthLabelsAsync("depth-canvas", "depth-labels",
                Item.DepthLevels, Item.DepthWidth, Item.DepthHeight);
        }
    }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(Item, _prevItem)) { _canvasReady = false; _prevItem = Item; }
        if (Painter.ActiveLevel > Settings.MaxDepthLevels)
            Painter.ActiveLevel = (byte)Settings.MaxDepthLevels;
    }

    [JSInvokable]
    public async Task OnCanvasInput(int x, int y, int buttons)
    {
        if (Item?.DepthLevels == null) return;
        var mask = Item.SolidMask ?? Item.DepthLevels.Select(l => l != 0).ToArray();
        bool changed = Painter.Tool == PainterTool.Paint
            ? Painter.CycleLevel(Item.DepthLevels, mask, Item.DepthWidth, Item.DepthHeight, x, y, Settings.MaxDepthLevels)
            : Painter.Apply(Item.DepthLevels, mask, Item.DepthWidth, Item.DepthHeight, x, y);
        if (!changed) return;
        await Js.RenderDepthOverlayAsync("depth-canvas", Item.DepthLevels,
            Item.DepthWidth, Item.DepthHeight, Settings.MaxDepthLevels);
        await Js.RenderDepthLabelsAsync("depth-canvas", "depth-labels",
            Item.DepthLevels, Item.DepthWidth, Item.DepthHeight);
        await OnChanged.InvokeAsync();
    }

    [JSInvokable]
    public async Task OnContextAction(string action)
    {
        if (Item?.DepthLevels == null) return;
        var mask = Item.SolidMask ?? Item.DepthLevels.Select(l => l != 0).ToArray();
        byte max = (byte)Settings.MaxDepthLevels;

        switch (action)
        {
            case "reset-to-one":
                for (int i = 0; i < Item.DepthLevels.Length; i++)
                    if (mask[i]) Item.DepthLevels[i] = 1;
                break;
            case "erase-all":
                Array.Clear(Item.DepthLevels, 0, Item.DepthLevels.Length);
                break;
            case "fill-all":
                for (int i = 0; i < Item.DepthLevels.Length; i++)
                    if (mask[i]) Item.DepthLevels[i] = Painter.ActiveLevel;
                break;
            case "invert":
                for (int i = 0; i < Item.DepthLevels.Length; i++)
                {
                    if (!mask[i] || Item.DepthLevels[i] == 0) continue;
                    // Clamp first — depth may exceed max if MaxDepthLevels was reduced after painting
                    var clamped = Math.Min(Item.DepthLevels[i], max);
                    Item.DepthLevels[i] = (byte)(max + 1 - clamped);
                }
                break;
        }

        await Js.RenderDepthOverlayAsync("depth-canvas", Item.DepthLevels,
            Item.DepthWidth, Item.DepthHeight, Settings.MaxDepthLevels);
        await Js.RenderDepthLabelsAsync("depth-canvas", "depth-labels",
            Item.DepthLevels, Item.DepthWidth, Item.DepthHeight);
        await OnChanged.InvokeAsync();
    }

    private bool ShowSimpleModeHint =>
        !Settings.PerPixelMode &&
        Item?.DepthLevels?.Any(l => l > 1) == true;

    private void SetTool(PainterTool tool) { Painter.Tool = tool; StateHasChanged(); }
    private string Active(PainterTool tool) => Painter.Tool == tool ? "active" : "";

    public async ValueTask DisposeAsync()
    {
        _self?.Dispose();
        await Task.CompletedTask;
    }
}
