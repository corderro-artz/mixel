@using Mixel.Web.Theming
@inject ThemeState Theme

<div class="theme-toggle" role="group" aria-label="Theme">
    <button type="button" class="tt-seg @(IsDark ? "" : "on")"
            aria-pressed="@(!IsDark)" @onclick='() => SetAsync("vaporsoft-light")'>Light</button>
    <button type="button" class="tt-seg @(IsDark ? "on" : "")"
            aria-pressed="@IsDark" @onclick='() => SetAsync("vaporsoft-dark")'>Dark</button>
</div>

@code {
    // The active side is whichever mode the current theme belongs to.
    private bool IsDark => ThemeRegistry.ById(Theme.CurrentId).Mode == ThemeMode.Dark;

    private async Task SetAsync(string id) => await Theme.SetAsync(id);
}
